{
  "name": "collagemaker",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:lan": "vite --host --mode lan",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "assets": "node scripts/copy-assets.mjs",
    "postinstall": "node scripts/copy-assets.mjs",
    "test:worker": "vitest run --config vitest.worker.config.ts",
    "check:worker": "tsc -p worker/tsconfig.json",
    "relay:deploy": "wrangler deploy --config worker/wrangler.toml"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261010.1",
    "@phosphor-icons/core": "^2.1.1",
    "@playwright/test": "^1.64.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@types/node": "^26.6.4",
    "@vite-pwa/assets-generator": "^2.0.0",
    "@vitejs/plugin-basic-ssl": "^2.3.0",
    "@vitest/browser-playwright": "^4.1.11",
    "playwright": "^1.64.0",
    "svelte": "^5.57.2",
    "svelte-check": "^4.7.6",
    "typescript": "^6.0.3",
    "vite": "^8.3.4",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^4.1.11",
    "wrangler": "^4.149.0"
  },
  "dependencies": {
    "@fontsource/baloo-2": "^5.3.0",
    "@fontsource/bangers": "^5.3.0",
    "@fontsource/caveat": "^5.3.0",
    "@fontsource/chewy": "^5.3.0",
    "@fontsource/fredoka": "^5.3.0",
    "@fontsource/luckiest-guy": "^5.3.0",
    "@fontsource/nunito": "^5.3.0",
    "@fontsource/pacifico": "^5.3.0",
    "@fontsource/permanent-marker": "^5.3.0",
    "@fontsource/sniglet": "^5.3.0",
    "@noble/hashes": "^2.4.0",
    "dexie": "^4.4.6",
    "driver.js": "^1.9.0",
    "jspdf": "^4.2.1",
    "jszip": "^3.10.2",
    "konva": "^10.7.1",
    "peerjs": "^1.5.5"
  }
}
